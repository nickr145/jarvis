#!/usr/bin/env python3
"""
jarvis — refresh what can be refreshed, then open the portal.

    jarvis                  refresh news, rebuild listings, open the portal
    jarvis --poll           also poll employer job boards (~70s)
    jarvis --no-refresh     open whatever is already on disk
    jarvis --port 8931      use a specific port
    jarvis --install        symlink this into ~/.local/bin so it runs anywhere

Serves the repo root so the page can read output/ alongside portal/.

**Email is not refreshed here, and cannot be.** The Gmail connector lives in a
Claude Code session, so a plain terminal cannot reach it. This picks up whatever
email.json the last Claude Code run left behind, and the portal reports that
file's age rather than presenting stale triage as current.
"""

import argparse
import functools
import os
import http.server
import json
import socketserver
import subprocess
import sys
import threading
import webbrowser
from pathlib import Path

ROOT = Path(__file__).parent.resolve()
OUTPUT = ROOT / "output"


def write_index() -> str | None:
    """List the dated output directories so a static page can find the newest.

    A page served over http:// cannot list a directory, and guessing today's
    date would make the portal silently blank on any day an agent didn't run.
    """
    dates = sorted(
        d.name for d in OUTPUT.iterdir()
        if d.is_dir() and len(d.name) == 10 and d.name[4] == "-"
    ) if OUTPUT.is_dir() else []

    latest = dates[-1] if dates else None
    OUTPUT.mkdir(exist_ok=True)
    (OUTPUT / "index.json").write_text(
        json.dumps({"latest": latest, "dates": dates}, indent=2)
    )
    return latest


def run_step(name: str, script: str, timeout: int) -> None:
    """Run one agent. A failure here is reported and skipped, never fatal —
    a partial brief beats no brief, and the portal renders a missing source
    as missing."""
    path = ROOT / "agents" / script
    if not path.exists():
        print(f"  {name}: {script} not found — skipped")
        return
    try:
        r = subprocess.run([sys.executable, str(path)], capture_output=True,
                           text=True, timeout=timeout)
        out = (r.stdout or r.stderr).strip().splitlines()
        print(f"  {name}: {out[-1] if out else 'no output'}")
    except subprocess.TimeoutExpired:
        print(f"  {name}: timed out — continuing with what is on disk")
    except OSError as e:
        print(f"  {name}: could not run ({e}) — continuing")


def install() -> None:
    """Symlink into ~/.local/bin so `jarvis` works from any directory."""
    target = Path.home() / ".local" / "bin"
    target.mkdir(parents=True, exist_ok=True)
    link = target / "jarvis"
    src = Path(__file__).resolve()
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(src)
    print(f"linked {link} -> {src}")
    if str(target) not in os.environ.get("PATH", "").split(":"):
        print(f"\n{target} is not on your PATH. Add this to ~/.zshrc:\n"
              f'  export PATH="$HOME/.local/bin:$PATH"')
    else:
        print("`jarvis` now works from anywhere.")


def main() -> None:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--no-refresh", action="store_true",
                    help="skip all agents, just open what exists")
    ap.add_argument("--poll", action="store_true",
                    help="also poll employer job boards (~70s)")
    ap.add_argument("--install", action="store_true",
                    help="symlink into ~/.local/bin and exit")
    ap.add_argument("--port", type=int, default=8731)
    args = ap.parse_args()

    if args.install:
        install()
        return

    if not args.no_refresh:
        print("refreshing:")
        run_step("news", "news_agent.py", 60)
        # The board poll is ~70s, so it is opt-in; the portal is otherwise up
        # in about two seconds.
        if args.poll:
            run_step("boards", "ats_poll.py", 300)
        run_step("listings", "build_listings.py", 60)

    latest = write_index()
    if latest is None:
        print("no output/ data yet — the portal will open and say so")
    else:
        print(f"latest output: {latest}")

    handler = functools.partial(http.server.SimpleHTTPRequestHandler,
                                directory=str(ROOT))
    socketserver.TCPServer.allow_reuse_address = True
    try:
        httpd = socketserver.TCPServer(("127.0.0.1", args.port), handler)
    except OSError as e:
        sys.exit(f"could not bind port {args.port}: {e}\ntry --port {args.port + 1}")

    url = f"http://127.0.0.1:{args.port}/portal/index.html"
    print(f"portal: {url}\nctrl-c to stop")
    threading.Timer(0.4, webbrowser.open, args=(url,)).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        httpd.server_close()


if __name__ == "__main__":
    main()
